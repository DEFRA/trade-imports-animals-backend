<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="error"/>

  <module name="SuppressionSingleFilter">
    <property name="id" value="noThreadWaitInTests"/>
    <property name="files" value="^(?!.*[\\/]src[\\/]test[\\/]).*$"/>
  </module>

  <module name="RegexpMultiline">
    <property name="id" value="logThrowableNotMessage"/>
    <property name="fileExtensions" value="java"/>
    <property name="format" value="\blog\.(warn|error)\([^;]*\.getMessage\(\)\s*\)\s*;"/>
    <property name="message" value="Pass the throwable as the last argument to log.warn or log.error, not only getMessage()."/>
  </module>

  <module name="RegexpSingleline">
    <property name="id" value="noIdsInConfigComments"/>
    <property name="fileExtensions" value="yml,yaml,properties"/>
    <property name="format" value="#.*(EUDPA-\d+|\b(c|cv|d|q|inc|req)-\d{3}\b|Design Release|DR2\.1|\bRuled\b|the real service)"/>
    <property name="message" value="No ticket keys, backlog or ruling ids, release names or session words in comments."/>
  </module>

  <module name="TreeWalker">
    <module name="TodoComment">
      <property name="id" value="noIdsInComments"/>
      <property name="format" value="EUDPA-\d+|\b(c|cv|d|q|inc|req)-\d{3}\b|Design Release|DR2\.1|\bRuled\b|the real service"/>
      <message key="todo.match" value="No ticket keys, backlog or ruling ids, release names or session words in comments."/>
    </module>

    <module name="RegexpSinglelineJava">
      <property name="id" value="noThreadWaitInTests"/>
      <property name="format" value="\bThread\.(sleep|onSpinWait)\s*\("/>
      <property name="ignoreComments" value="true"/>
      <property name="message" value="Tests wait on the condition (Awaitility), not Thread.sleep or Thread.onSpinWait."/>
    </module>
  </module>
</module>
